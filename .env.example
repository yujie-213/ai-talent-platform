# 本机复制为 .env；随机密码与密钥在本机生成，禁止提交 .env。
JWT_SECRET=replace-with-at-least-32-random-characters
MYSQL_ROOT_PASSWORD=replace-locally
MYSQL_PASSWORD=replace-locally
DATABASE_URL=mysql+pymysql://talent:replace-locally@127.0.0.1:13306/talent
BROKER_URL=redis://127.0.0.1:16379/0
FILE_ROOT=./data/files
# 第二阶段：本机填写，勿将密钥发到聊天或提交 Git。
# BASE_URL 包含服务商要求的 /v1 前缀；需支持 chat/completions 和 json_object。
RESUME_LLM_BASE_URL=
RESUME_LLM_MODEL=
RESUME_LLM_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
# 从本机 /api/tags 记录的模型 digest；变更时停止旧索引写入并重新建库。
EMBEDDING_EXPECTED_DIGEST=
MILVUS_URL=http://127.0.0.1:19530
