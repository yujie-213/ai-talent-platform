# 仅为本项目后台增加已锁定聊天依赖，不重建/升级独立OCR环境。
FROM ai-talent-stage2-backend:0.2.1
COPY backend/requirements.lock.txt /tmp/stage4-requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install --index-url https://pypi.org/simple -r /tmp/stage4-requirements.txt && pip check
COPY backend /workspace/backend
